# Application
APP_NAME=TaskHub API
APP_VERSION=1.0.0
APP_DESCRIPTION=Collaborative workspace and task management API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1,test
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false

# Authentication - development placeholder only; replace in every deployment.
JWT_SECRET_KEY=development-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis task-list cache
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_FAIL_FAST=false
TASK_LIST_CACHE_TTL_SECONDS=60

# Day 7 uses a safe logging sender; SMTP is intentionally not required.
EMAIL_BACKEND=logging

# Docker Compose local PostgreSQL credentials (replace outside local development).
POSTGRES_DB=taskhub
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=change-me
