APP_NAME=FastAPI Practice
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false

# Development only. Set a long random value in every deployed environment.
SECRET_KEY=development-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
